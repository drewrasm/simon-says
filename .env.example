DATABASE_URL=postgresql://simon_says:local-simon-says@127.0.0.1:54329/simon_says
SESSION_SECRET=local-only-replace-before-deploy-32-characters
S3_ENDPOINT=http://127.0.0.1:19000
S3_REGION=us-east-1
S3_BUCKET=simon-says
S3_ACCESS_KEY_ID=simon-says-local
S3_SECRET_ACCESS_KEY=local-simon-says-storage
S3_FORCE_PATH_STYLE=true

# Caption names only. Optional provider configuration is server-only.
# OPENAI_API_KEY
# CAPTION_MODEL
# CAPTION_RECONNECT_GRACE_MS
# CAPTION_DELAY
# CAPTIONS_DEV_SESSION

ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INFERENCE_ID=

# Server-only OpenAI recap generation. Set OPENAI_API_KEY in the environment
