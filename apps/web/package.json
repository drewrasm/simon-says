    "cn": "0.5.2",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/ws": "8.18.1",
    "tailwindcss": "4.3.5",
    "esbuild": "^0.28.2"
  }
