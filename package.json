{
  "name": "simon-says",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.22.0 <23",
    "pnpm": "11.24.0"
  },
  "scripts": {
    "dev": "pnpm --filter @simon-says/web dev",
    "build": "pnpm db:generate && pnpm --filter @simon-says/web build",
    "start": "pnpm --filter @simon-says/web start",
    "typecheck": "pnpm db:generate && pnpm -r --if-present typecheck && tsc -p scripts/tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "services:up": "docker compose -f infra/compose.yaml up -d --wait",
    "services:down": "docker compose -f infra/compose.yaml down",
    "db:generate": "pnpm --filter @simon-says/db generate",
    "db:validate": "pnpm --filter @simon-says/db validate",
    "db:check": "pnpm --filter @simon-says/db check",
    "storage:check": "sh infra/check-storage.sh",
    "es:setup": "tsx scripts/es-setup.ts",
    "es:smoke": "tsx scripts/es-smoke.ts"
  },
  "devDependencies": {
    "@elastic/elasticsearch": "9.5.1",
    "@simon-says/contracts": "workspace:*",
    "@types/node": "22.19.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.5",
    "prettier": "^3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "^5.1.0",
    "ws": "^8.22.2"
  }
}
